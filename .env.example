PORT=10000
SUPABASE_URL=https://xxxx.supabase.co
# service_role key SECRET hai: sirf Render/.env mein, kabhi GitHub ya frontend mein nahi
SUPABASE_SERVICE_KEY=service_role_key_yahan
# kam se kam 32 random akshar (README mein banane ka command hai)
JWT_SECRET=
# naya chamber/vakil banane ki aapki apni chaabi, 16+ akshar
SETUP_KEY=

# ---- Update 4 (sab optional) ----
# Cloudflare R2 (10 GB free). STORAGE=r2 likhne par charon R2 variable zaroori hain
# STORAGE=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=court-docs
# Google Drive jodein (charon hon tabhi feature dikhta hai)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://court-chanchalmalda.onrender.com/api/drive/callback
# DRIVE_TOKEN_KEY=
